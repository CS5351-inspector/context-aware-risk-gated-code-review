          "id": "review.js:1",
          "file": "review.js",
          "side": "RIGHT",
          "line": 2,
          "severity": "high",
          "message": "Replacing `lookup(account) === GRANTED` with `Boolean(lookup(account))` breaks the access-control check. Per policy.js, GRANTED is 0 while DENIED/SUSPENDED are non-zero. Boolean(value) is false for 0 and true for any non-zero, so this inverts authorization: a GRANTED user is now denied, and DENIED/SUSPENDED users are treated as authorized (suspended/denied users gain download access). This is a high-severity authorization bypass. Restore `=== GRANTED` (and be mindful of undefined lookup results).",
          "evidenceIds": [
            "C0",
            "C1",
            "C2"
          ],
          "validation": "VERIFIED"
        }
      ],
      "error": null
    },
