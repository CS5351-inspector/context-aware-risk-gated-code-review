{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Content-bound human gold confirmation v2",
  "required": [
    "case_id",
    "content_sha256",
    "reviews"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "is_human",
          "decision",
          "evidence"
        ],
        "properties": {
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "is_human": {
            "const": true
          },
          "decision": {
            "const": "accepted"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$comment": "A real single-human confirmation is sufficient for development. Runtime validation additionally requires two distinct, dated human sign-offs for heldout. New records omit reviewer identity and date; optional legacy fields remain readable. Drafts intentionally fail until accepted with evidence. Runtime also verifies the content digest and family-wide label consistency."
}
